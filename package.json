{
  "name": "intelligent-teaching-research-assistant-refactor-plan",
  "private": true,
  "version": "0.1.0",
  "description": "Executable SDD/TDD refactor workspace for the Intelligent Teaching Research Assistant.",
  "scripts": {
    "verify:structure": "node tools/verify-structure.mjs",
    "test:tools": "node --test tools/*.test.mjs",
    "budget:connections": "node tools/connection-budget.mjs --config contracts/config/connection-budget.current.json",
    "budget:connections:audited": "node tools/connection-budget.mjs --config contracts/config/connection-budget.current-audited-worst-case.json",
    "budget:connections:direct-limited": "node tools/connection-budget.mjs --config contracts/config/connection-budget.proposed-direct-limited.json",
    "budget:connections:pgbouncer": "node tools/connection-budget.mjs --config contracts/config/connection-budget.proposed-pgbouncer-transaction.json",
    "audit:legacy-db-pools": "node tools/legacy-db-pool-audit.mjs --root ../智能教研助手/backend/app --out reports/legacy-db-pool-audit.current.json",
    "plan:legacy-db-pools": "node tools/legacy-db-pool-remediation.mjs --audit reports/legacy-db-pool-audit.current.json --out reports/legacy-db-pool-remediation.current.json",
    "audit:pgbouncer-perf:current": "node tools/pgbouncer-perf-profile-audit.mjs --profile contracts/config/pgbouncer-perf-profile.current.json --out reports/pgbouncer-perf-profile.current.json --allow-fail",
    "audit:pgbouncer-perf:proposed": "node tools/pgbouncer-perf-profile-audit.mjs --profile contracts/config/pgbouncer-perf-profile.proposed.json --out reports/pgbouncer-perf-profile.proposed.json",
    "audit:identity-access": "node tools/identity-access-contract-audit.mjs --openapi contracts/openapi/identity-access.yaml --principal-schema contracts/auth/principal-context.schema.json --access-matrix contracts/auth/access-matrix.json --out reports/identity-access-contract.current.json",
    "audit:identity-session-runtime": "node tools/identity-session-runtime-profile-audit.mjs --out reports/identity-session-runtime-profile.current.json",
    "perf:identity-session:up": "docker compose -f infra/perf/docker-compose.identity-session.yml up -d",
    "perf:identity-session:down": "docker compose -f infra/perf/docker-compose.identity-session.yml down",
    "perf:identity-session:reset": "docker compose -f infra/perf/docker-compose.identity-session.yml down -v",
    "test:identity-session:postgres": "go test ./services/identity-access-gateway/internal/adapter/postgres -run TestSessionStorePostgresIntegrationLifecycle -count=1 -v",
    "test:identity-session:pgbouncer": "node tools/run-identity-session-integration.mjs",
    "bench:identity-session:pgbouncer": "node tools/run-identity-session-benchmark.mjs",
    "summary:identity-session-benchmark": "node tools/identity-session-benchmark-summary.mjs",
    "bench:identity-http:pgbouncer": "node tools/run-identity-http-benchmark.mjs",
    "test:go": "go test ./services/conversation-write-gateway/... ./services/identity-access-gateway/... ./services/teaching-archive-gateway/...",
    "test:rust": "cargo test --manifest-path services/agent-harness/Cargo.toml",
    "test": "npm run verify:structure && npm run test:tools && npm run test:go && npm run test:rust",
    "quality": "node tools/quality-gate.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
