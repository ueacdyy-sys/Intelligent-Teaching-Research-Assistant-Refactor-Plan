{
  "name": "intelligent-teaching-research-assistant-refactor-plan",
  "private": true,
  "version": "0.1.0",
  "description": "Executable SDD/TDD refactor workspace for the Intelligent Teaching Research Assistant.",
  "scripts": {
    "verify:structure": "node tools/verify-structure.mjs",
    "test:tools": "node --test tools/*.test.mjs",
    "budget:connections": "node tools/connection-budget.mjs --config contracts/config/connection-budget.current.json",
    "budget:connections:audited": "node tools/connection-budget.mjs --config contracts/config/connection-budget.current-audited-worst-case.json",
    "budget:connections:direct-limited": "node tools/connection-budget.mjs --config contracts/config/connection-budget.proposed-direct-limited.json",
    "budget:connections:pgbouncer": "node tools/connection-budget.mjs --config contracts/config/connection-budget.proposed-pgbouncer-transaction.json",
    "audit:legacy-db-pools": "node tools/legacy-db-pool-audit.mjs --root ../智能教研助手/backend/app --out reports/legacy-db-pool-audit.current.json",
    "plan:legacy-db-pools": "node tools/legacy-db-pool-remediation.mjs --audit reports/legacy-db-pool-audit.current.json --out reports/legacy-db-pool-remediation.current.json",
    "audit:pgbouncer-perf:current": "node tools/pgbouncer-perf-profile-audit.mjs --profile contracts/config/pgbouncer-perf-profile.current.json --out reports/pgbouncer-perf-profile.current.json",
    "audit:pgbouncer-perf:proposed": "node tools/pgbouncer-perf-profile-audit.mjs --profile contracts/config/pgbouncer-perf-profile.proposed.json --out reports/pgbouncer-perf-profile.proposed.json",
    "audit:identity-access": "node tools/identity-access-contract-audit.mjs --openapi contracts/openapi/identity-access.yaml --principal-schema contracts/auth/principal-context.schema.json --access-matrix contracts/auth/access-matrix.json --out reports/identity-access-contract.current.json",
    "audit:identity-session-runtime": "node tools/identity-session-runtime-profile-audit.mjs --out reports/identity-session-runtime-profile.current.json",
    "audit:student-app-flow": "node tools/student-app-flow-audit.mjs --out reports/student-app-flow.current.json",
    "audit:agent-harness-flow": "node tools/agent-harness-flow-audit.mjs --out reports/agent-harness-flow.current.json",
    "audit:workflow-plugin-flow": "node tools/workflow-plugin-flow-audit.mjs --out reports/workflow-plugin-flow.current.json",
    "audit:workflow-plugin-registry": "node tools/workflow-plugin-registry-admission.mjs --out reports/workflow-plugin-registry-admission.current.json",
    "audit:workflow-plugin-revision": "node tools/workflow-plugin-revision-feedback.mjs --out reports/workflow-plugin-revision-feedback.current.json",
    "audit:ai-worker-job": "node tools/ai-worker-job-audit.mjs --out reports/ai-worker-job.current.json",
    "audit:knowledge-policy": "node tools/knowledge-access-policy-audit.mjs --out reports/knowledge-access-policy.current.json",
    "audit:ai-worker-job-admission": "node tools/ai-worker-job-admission.mjs --out reports/ai-worker-job-admission.current.json",
    "audit:knowledge-retrieval-benchmark": "node tools/knowledge-retrieval-benchmark-audit.mjs --out reports/knowledge-retrieval-benchmark.current.json",
    "audit:ai-worker-runtime-dependencies": "node tools/ai-worker-runtime-dependency-profile-audit.mjs --out reports/ai-worker-runtime-dependency-profile.current.json",
    "audit:conversation-fanout-decision": "node tools/conversation-fanout-decision-audit.mjs --out reports/conversation-fanout-decision.current.json",
    "audit:conversation-client-trace-attribution": "node tools/conversation-client-trace-attribution-audit.mjs --out reports/conversation-client-trace-attribution.current.json",
    "audit:conversation-transport-profile": "node tools/conversation-transport-profile-decision-audit.mjs --out reports/conversation-transport-profile-decision.current.json",
    "audit:conversation-loadgen-runtime": "node tools/conversation-loadgen-runtime-decision-audit.mjs --out reports/conversation-loadgen-runtime-decision.current.json",
    "audit:root-workflow-coverage": "node tools/root-workflow-coverage-audit.mjs --out reports/root-workflow-coverage.current.json",
    "audit:cross-module-db-queue": "node tools/cross-module-db-queue-diagnostics-audit.mjs --out reports/cross-module-db-queue-diagnostics.current.json",
    "audit:pgbouncer-production-headroom": "node tools/pgbouncer-production-headroom-audit.mjs --out reports/pgbouncer-production-headroom.current.json",
    "audit:root-slo-promotion-review": "node tools/root-slo-promotion-review-audit.mjs --out reports/root-slo-promotion-review.current.json",
    "audit:system-capacity-claim": "node tools/system-capacity-claim-audit.mjs --out reports/system-capacity-claim.current.json",
    "audit:performance-evidence": "node tools/performance-evidence-registry-audit.mjs --out reports/performance-evidence-registry.current.json",
    "perf:identity-session:up": "docker compose -f infra/perf/docker-compose.identity-session.yml up -d",
    "perf:identity-session:down": "docker compose -f infra/perf/docker-compose.identity-session.yml down",
    "perf:identity-session:reset": "docker compose -f infra/perf/docker-compose.identity-session.yml down -v",
    "test:identity-session:postgres": "go test ./services/identity-access-gateway/internal/adapter/postgres -run TestSessionStorePostgresIntegrationLifecycle -count=1 -v",
    "test:identity-session:pgbouncer": "node tools/run-identity-session-integration.mjs",
    "bench:identity-session:pgbouncer": "node tools/run-identity-session-benchmark.mjs",
    "maint:identity-session:pgbouncer": "go run ./services/identity-access-gateway/cmd/sessionmaint -database-url postgres://app_user:ueacd@127.0.0.1:16432/intelligent_teaching_assistant?sslmode=disable",
    "summary:identity-session-benchmark": "node tools/identity-session-benchmark-summary.mjs",
    "bench:identity-http:pgbouncer": "node tools/run-identity-http-benchmark.mjs",
    "bench:identity-http:pgbouncer:docker": "node tools/run-identity-http-benchmark.mjs --benchmark-runtime docker",
    "bench:identity-phase-matrix": "node tools/run-identity-phase-matrix.mjs",
    "bench:conversation-write:http": "go run ./services/conversation-write-gateway/cmd/httpbench",
    "bench:conversation-write:pgbouncer": "node tools/run-conversation-write-benchmark.mjs",
    "bench:conversation-write:pgbouncer:docker": "node tools/run-conversation-write-benchmark.mjs --benchmark-runtime docker",
    "bench:conversation-write:pgbouncer:wsl": "node tools/run-conversation-write-benchmark.mjs --benchmark-runtime wsl --benchmark-wsl-host 172.28.160.1",
    "bench:teaching-archive:pgbouncer": "node tools/run-teaching-archive-benchmark.mjs",
    "bench:system-mixed-workload": "node tools/run-system-mixed-workload-benchmark.mjs",
    "bench:system-mixed-workload:ladder": "node tools/run-system-mixed-workload-ladder.mjs",
    "bench:system-sustained-mixed-workload": "node tools/run-system-sustained-mixed-workload.mjs",
    "bench:system-sustained-mixed-workload:scaleup": "node tools/run-system-sustained-mixed-workload-scaleup.mjs",
    "test:go": "go test ./services/conversation-write-gateway/... ./services/identity-access-gateway/... ./services/teaching-archive-gateway/...",
    "test:rust": "cargo test --manifest-path services/agent-harness/Cargo.toml",
    "test": "npm run verify:structure && npm run test:tools && npm run test:go && npm run test:rust",
    "quality": "node tools/quality-gate.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
