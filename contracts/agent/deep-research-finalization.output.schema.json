{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/agent/deep-research-finalization.output.schema.json",
  "title": "Deep Research Finalization Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeId",
    "commandPort",
    "status",
    "recordId",
    "recordedAt",
    "idempotencyKey",
    "idempotentReplay",
    "job",
    "artifact",
    "evidenceRefs",
    "boundary",
    "runtimeSlo",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-05.research.deep-research-finalization-recorded.v1"
    },
    "runtimeId": { "type": "string", "const": "research_deep_research_finalization_runtime" },
    "commandPort": {
      "type": "string",
      "const": "DeepResearchFinalizationPort.recordDeepResearchFinalization"
    },
    "status": { "type": "string", "const": "FINAL_ANSWER_FINALIZED_NOT_PUBLISHED" },
    "recordId": { "type": "string", "minLength": 1 },
    "recordedAt": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 220 },
    "idempotentReplay": { "type": "boolean" },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "contextRef", "jobId", "queueName"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "contextRef": { "type": "string", "minLength": 1 },
        "jobId": { "type": "string", "minLength": 1 },
        "queueName": { "type": "string", "const": "research_deep_research" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactKind",
        "finalizationLabel",
        "deliveryState",
        "reviewRecordId",
        "reviewerPrincipalId",
        "finalizerPrincipalId",
        "claimCount",
        "citationCount",
        "sourceHashCount"
      ],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "artifactKind": { "type": "string", "const": "REVIEWED_DEEP_RESEARCH_FINALIZATION_RECORD" },
        "finalizationLabel": { "type": "string", "minLength": 1 },
        "deliveryState": { "type": "string", "const": "FINALIZED_NOT_PUBLISHED" },
        "reviewRecordId": { "type": "string", "minLength": 1 },
        "reviewerPrincipalId": { "type": "string", "minLength": 1 },
        "finalizerPrincipalId": { "type": "string", "minLength": 1 },
        "claimCount": { "type": "integer", "minimum": 1 },
        "citationCount": { "type": "integer", "minimum": 1 },
        "sourceHashCount": { "type": "integer", "minimum": 1 }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedReviewVerified",
        "humanFinalAnswerReviewRecorded",
        "finalAnswerFinalized",
        "finalAnswerGenerated",
        "finalAnswerPublished",
        "publicationCandidateCreated",
        "directPublicationAllowed",
        "externalModelCallStarted",
        "mainDatabaseWriteStarted",
        "studentArchiveWriteStarted",
        "remoteDeviceControlAllowed",
        "localToolMutationAllowed",
        "swarmAllowed",
        "requiresFuturePublicationReview"
      ],
      "properties": {
        "approvedReviewVerified": { "type": "boolean", "const": true },
        "humanFinalAnswerReviewRecorded": { "type": "boolean", "const": true },
        "finalAnswerFinalized": { "type": "boolean", "const": true },
        "finalAnswerGenerated": { "type": "boolean", "const": false },
        "finalAnswerPublished": { "type": "boolean", "const": false },
        "publicationCandidateCreated": { "type": "boolean", "const": false },
        "directPublicationAllowed": { "type": "boolean", "const": false },
        "externalModelCallStarted": { "type": "boolean", "const": false },
        "mainDatabaseWriteStarted": { "type": "boolean", "const": false },
        "studentArchiveWriteStarted": { "type": "boolean", "const": false },
        "remoteDeviceControlAllowed": { "type": "boolean", "const": false },
        "localToolMutationAllowed": { "type": "boolean", "const": false },
        "swarmAllowed": { "type": "boolean", "const": false },
        "requiresFuturePublicationReview": { "type": "boolean", "const": true }
      }
    },
    "runtimeSlo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetP99Ms", "evidenceClass"],
      "properties": {
        "targetP99Ms": { "type": "integer", "minimum": 1, "maximum": 300 },
        "evidenceClass": {
          "type": "string",
          "const": "ASYNC_DEEP_RESEARCH_FINALIZATION_BOUNDARY"
        }
      }
    },
    "nextAction": { "type": "string", "minLength": 1 }
  }
}
