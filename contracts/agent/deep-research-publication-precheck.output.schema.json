{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/agent/deep-research-publication-precheck.output.schema.json",
  "title": "Deep Research Publication Precheck Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeId",
    "commandPort",
    "status",
    "recordId",
    "recordedAt",
    "idempotencyKey",
    "idempotentReplay",
    "job",
    "precheck",
    "evidenceRefs",
    "boundary",
    "runtimeSlo",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-05.research.deep-research-publication-precheck-recorded.v1"
    },
    "runtimeId": { "type": "string", "const": "research_deep_research_publication_precheck_runtime" },
    "commandPort": {
      "type": "string",
      "const": "DeepResearchPublicationPrecheckPort.recordDeepResearchPublicationPrecheck"
    },
    "status": {
      "type": "string",
      "enum": ["PUBLICATION_PRECHECK_APPROVED_NOT_DELIVERED", "PUBLICATION_PRECHECK_REVISION_REQUIRED"]
    },
    "recordId": { "type": "string", "minLength": 1 },
    "recordedAt": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 220 },
    "idempotentReplay": { "type": "boolean" },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "contextRef", "jobId", "queueName"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "contextRef": { "type": "string", "minLength": 1 },
        "jobId": { "type": "string", "minLength": 1 },
        "queueName": { "type": "string", "const": "research_deep_research" }
      }
    },
    "precheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precheckId",
        "reviewerPrincipalId",
        "decision",
        "approvedForFutureDelivery",
        "revisionRequired",
        "previewId",
        "artifactId",
        "claimCount",
        "citationCount",
        "sourceHashCount",
        "risk",
        "comments"
      ],
      "properties": {
        "precheckId": { "type": "string", "minLength": 1 },
        "reviewerPrincipalId": { "type": "string", "minLength": 1 },
        "decision": {
          "type": "string",
          "enum": ["APPROVED_FOR_DELIVERY_RUNTIME", "REVISION_REQUIRED", "REJECTED"]
        },
        "approvedForFutureDelivery": { "type": "boolean" },
        "revisionRequired": { "type": "boolean" },
        "previewId": { "type": "string", "minLength": 1 },
        "artifactId": { "type": "string", "minLength": 1 },
        "claimCount": { "type": "integer", "minimum": 1 },
        "citationCount": { "type": "integer", "minimum": 1 },
        "sourceHashCount": { "type": "integer", "minimum": 1 },
        "risk": { "type": "object" },
        "comments": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderPreviewVerified",
        "humanPublicationPrecheckRecorded",
        "evidenceIntegrityReviewed",
        "safetyReviewed",
        "studentVisibilityReviewed",
        "approvedForFutureDelivery",
        "revisionRequired",
        "publicationCandidateCreated",
        "finalAnswerPublished",
        "studentVisible",
        "directPublicationAllowed",
        "externalModelCallStarted",
        "mainDatabaseWriteStarted",
        "studentArchiveWriteStarted",
        "remoteDeviceControlAllowed",
        "localToolMutationAllowed",
        "swarmAllowed",
        "requiresFutureDeliveryRuntime"
      ],
      "properties": {
        "renderPreviewVerified": { "type": "boolean", "const": true },
        "humanPublicationPrecheckRecorded": { "type": "boolean", "const": true },
        "evidenceIntegrityReviewed": { "type": "boolean", "const": true },
        "safetyReviewed": { "type": "boolean", "const": true },
        "studentVisibilityReviewed": { "type": "boolean", "const": true },
        "approvedForFutureDelivery": { "type": "boolean" },
        "revisionRequired": { "type": "boolean" },
        "publicationCandidateCreated": { "type": "boolean", "const": false },
        "finalAnswerPublished": { "type": "boolean", "const": false },
        "studentVisible": { "type": "boolean", "const": false },
        "directPublicationAllowed": { "type": "boolean", "const": false },
        "externalModelCallStarted": { "type": "boolean", "const": false },
        "mainDatabaseWriteStarted": { "type": "boolean", "const": false },
        "studentArchiveWriteStarted": { "type": "boolean", "const": false },
        "remoteDeviceControlAllowed": { "type": "boolean", "const": false },
        "localToolMutationAllowed": { "type": "boolean", "const": false },
        "swarmAllowed": { "type": "boolean", "const": false },
        "requiresFutureDeliveryRuntime": { "type": "boolean", "const": true }
      }
    },
    "runtimeSlo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetP99Ms", "evidenceClass"],
      "properties": {
        "targetP99Ms": { "type": "integer", "minimum": 1, "maximum": 300 },
        "evidenceClass": {
          "type": "string",
          "const": "ASYNC_DEEP_RESEARCH_PUBLICATION_PRECHECK_BOUNDARY"
        }
      }
    },
    "nextAction": { "type": "string", "minLength": 1 }
  }
}
