{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelligent-teaching-assistant.local/contracts/agent/deep-research-student-archive-storage-precommit.output.schema.json",
  "title": "Research deep_research student archive storage precommit output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeId",
    "commandPort",
    "status",
    "recordId",
    "recordedAt",
    "idempotencyKey",
    "idempotentReplay",
    "sourceProjection",
    "teachingArchiveCreateCommand",
    "evidenceRefs",
    "boundary",
    "runtimeSlo",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2026-06-05.research.deep-research-student-archive-storage-precommit-prepared.v1"
    },
    "runtimeId": {
      "const": "research_deep_research_student_archive_storage_precommit_runtime"
    },
    "commandPort": {
      "const": "DeepResearchStudentArchiveStoragePrecommitPort.prepareTeachingArchiveCreateCommand"
    },
    "status": {
      "const": "TEACHING_ARCHIVE_MAIN_DB_STORAGE_PRECOMMIT_PREPARED"
    },
    "recordId": { "type": "string", "minLength": 1 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 240 },
    "idempotentReplay": { "type": "boolean" },
    "sourceProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionRecordId",
        "projectionId",
        "archiveScopeRef",
        "sourceProjectionReviewRecordId",
        "sourcePersistenceRecordId",
        "sourceStudentDeliveryEnvelopeId",
        "claimCount",
        "citationCount",
        "sourceHashCount"
      ],
      "properties": {
        "projectionRecordId": { "type": "string", "minLength": 1 },
        "projectionId": { "type": "string", "minLength": 1 },
        "archiveScopeRef": { "type": "string", "minLength": 1 },
        "sourceProjectionReviewRecordId": { "type": "string", "minLength": 1 },
        "sourcePersistenceRecordId": { "type": "string", "minLength": 1 },
        "sourceStudentDeliveryEnvelopeId": { "type": "string", "minLength": 1 },
        "claimCount": { "type": "integer", "minimum": 1 },
        "citationCount": { "type": "integer", "minimum": 1 },
        "sourceHashCount": { "type": "integer", "minimum": 1 }
      }
    },
    "teachingArchiveCreateCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "operationId",
        "method",
        "path",
        "preparedAt",
        "targetUseCase",
        "targetRepository",
        "targetTable",
        "principalContextHeader",
        "requestBody",
        "storageShape"
      ],
      "properties": {
        "commandId": { "type": "string", "minLength": 1 },
        "operationId": { "const": "createTeachingArchiveItem" },
        "method": { "const": "POST" },
        "path": { "const": "/archive-items" },
        "preparedAt": { "type": "string", "format": "date-time" },
        "targetUseCase": { "const": "CreateArchiveItem.ExecuteWithPersistence" },
        "targetRepository": { "const": "ArchiveRepository.Create" },
        "targetTable": { "const": "teaching_archive_items" },
        "principalContextHeader": { "type": "object" },
        "requestBody": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ownerType",
            "studentId",
            "materialType",
            "title",
            "source",
            "contentRef",
            "tags",
            "analysisIntents",
            "ocrReserved"
          ],
          "properties": {
            "ownerType": { "const": "STUDENT" },
            "studentId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "materialType": { "enum": ["QUIZ", "PAPER", "HANDOUT", "HOMEWORK"] },
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "source": { "const": "SYSTEM_IMPORT" },
            "contentRef": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "tags": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 64 }
            },
            "analysisIntents": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": { "enum": ["ARCHIVE_ONLY", "TUTORING"] }
            },
            "ocrReserved": { "type": "boolean" }
          }
        },
        "storageShape": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "idPrefix", "columns", "evidenceLocation"],
          "properties": {
            "table": { "const": "teaching_archive_items" },
            "idPrefix": { "const": "tarch_" },
            "columns": {
              "type": "array",
              "contains": { "const": "content_ref" },
              "items": { "type": "string" }
            },
            "evidenceLocation": { "const": "append_only_projection_log" }
          }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "studentArchiveProjectionOutputVerified": { "const": true },
        "teachingArchiveCreateItemCommandPrepared": { "const": true },
        "teachingArchiveDomainValidationPrepared": { "const": true },
        "projectionEvidencePreserved": { "const": true },
        "studentAudienceScopeEnforced": { "const": true },
        "studentArchiveProjectionWritten": { "const": true },
        "studentArchivePersisted": { "const": true },
        "studentArchiveWriteStarted": { "const": true },
        "mainDatabaseWritePrepared": { "const": true },
        "mainDatabaseWriteStarted": { "const": false },
        "mainDatabaseWriteCommitted": { "const": false },
        "directDatabaseAccessAllowed": { "const": false },
        "executeHttpRequestAllowed": { "const": false },
        "finalAnswerPublished": { "const": false },
        "publicationCandidateCreated": { "const": false },
        "externalModelCallStarted": { "const": false },
        "remoteDeviceControlAllowed": { "const": false },
        "localToolMutationAllowed": { "const": false },
        "swarmAllowed": { "const": false }
      }
    },
    "runtimeSlo": {
      "type": "object",
      "required": ["targetP99Ms", "evidenceClass"],
      "properties": {
        "targetP99Ms": { "const": 300 },
        "evidenceClass": {
          "const": "ASYNC_DEEP_RESEARCH_STUDENT_ARCHIVE_STORAGE_PRECOMMIT_BOUNDARY"
        }
      }
    },
    "nextAction": { "type": "string", "minLength": 1 }
  }
}
