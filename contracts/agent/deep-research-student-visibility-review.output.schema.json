{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/agent/deep-research-student-visibility-review.output.schema.json",
  "title": "Deep Research Student Visibility Review Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeId",
    "commandPort",
    "status",
    "recordId",
    "recordedAt",
    "idempotencyKey",
    "idempotentReplay",
    "job",
    "teacherDeliveryPackage",
    "studentVisibilityReview",
    "evidenceRefs",
    "boundary",
    "runtimeSlo",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-05.research.deep-research-student-visibility-review-recorded.v1"
    },
    "runtimeId": { "type": "string", "const": "research_deep_research_student_visibility_review_runtime" },
    "commandPort": {
      "type": "string",
      "const": "DeepResearchStudentVisibilityReviewPort.recordStudentVisibilityReview"
    },
    "status": {
      "type": "string",
      "const": "STUDENT_VISIBILITY_REVIEW_APPROVED_NOT_DELIVERED"
    },
    "recordId": { "type": "string", "minLength": 1 },
    "recordedAt": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 240 },
    "idempotentReplay": { "type": "boolean" },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "contextRef", "jobId", "queueName"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "contextRef": { "type": "string", "minLength": 1 },
        "jobId": { "type": "string", "minLength": 1 },
        "queueName": { "type": "string", "const": "research_deep_research" }
      }
    },
    "teacherDeliveryPackage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "packageId",
        "packageKind",
        "previewId",
        "artifactId",
        "title",
        "summary",
        "claimCount",
        "citationCount",
        "sourceHashCount",
        "claims",
        "limitations",
        "risk"
      ],
      "properties": {
        "packageId": { "type": "string", "minLength": 1 },
        "packageKind": { "type": "string", "const": "EVIDENCE_GROUNDED_TEACHER_DELIVERY_PACKAGE" },
        "previewId": { "type": "string", "minLength": 1 },
        "artifactId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "claimCount": { "type": "integer", "minimum": 1 },
        "citationCount": { "type": "integer", "minimum": 1 },
        "sourceHashCount": { "type": "integer", "minimum": 1 },
        "claims": { "type": "array", "minItems": 1 },
        "limitations": { "type": "array", "minItems": 1 },
        "risk": { "type": "object" }
      }
    },
    "studentVisibilityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewId",
        "reviewerPrincipalId",
        "decision",
        "approvedForFutureStudentDelivery",
        "revisionRequired",
        "teacherDeliveryRecordId",
        "teacherDeliveryPackageId",
        "targetAudience",
        "teacherDeliveryReviewed",
        "evidenceIntegrityReviewed",
        "sourceHashIntegrityReviewed",
        "limitationsReviewed",
        "studentDataDisclosureReviewed",
        "privateKnowledgeDisclosureReviewed",
        "ageAppropriateReviewed",
        "teacherAccountabilityAccepted",
        "comments"
      ],
      "properties": {
        "reviewId": { "type": "string", "minLength": 1 },
        "reviewerPrincipalId": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "const": "APPROVED_FOR_STUDENT_VISIBILITY_DELIVERY_RUNTIME" },
        "approvedForFutureStudentDelivery": { "type": "boolean", "const": true },
        "revisionRequired": { "type": "boolean", "const": false },
        "teacherDeliveryRecordId": { "type": "string", "minLength": 1 },
        "teacherDeliveryPackageId": { "type": "string", "minLength": 1 },
        "targetAudience": { "type": "object" },
        "teacherDeliveryReviewed": { "type": "boolean", "const": true },
        "evidenceIntegrityReviewed": { "type": "boolean", "const": true },
        "sourceHashIntegrityReviewed": { "type": "boolean", "const": true },
        "limitationsReviewed": { "type": "boolean", "const": true },
        "studentDataDisclosureReviewed": { "type": "boolean", "const": true },
        "privateKnowledgeDisclosureReviewed": { "type": "boolean", "const": true },
        "ageAppropriateReviewed": { "type": "boolean", "const": true },
        "teacherAccountabilityAccepted": { "type": "boolean", "const": true },
        "comments": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teacherDeliveryVerified",
        "humanStudentVisibilityReviewRecorded",
        "studentVisibilityApprovedForFutureDelivery",
        "evidenceIntegrityPreserved",
        "sourceHashIntegrityPreserved",
        "limitationsPreserved",
        "studentAudienceScopeReviewed",
        "finalAnswerPublished",
        "publicationCandidateCreated",
        "studentVisible",
        "studentDeliveryStarted",
        "directPublicationAllowed",
        "externalModelCallStarted",
        "mainDatabaseWriteStarted",
        "studentArchiveWriteStarted",
        "remoteDeviceControlAllowed",
        "localToolMutationAllowed",
        "swarmAllowed",
        "requiresFutureStudentDeliveryRuntime",
        "requiresFuturePersistenceReview"
      ],
      "properties": {
        "teacherDeliveryVerified": { "type": "boolean", "const": true },
        "humanStudentVisibilityReviewRecorded": { "type": "boolean", "const": true },
        "studentVisibilityApprovedForFutureDelivery": { "type": "boolean", "const": true },
        "evidenceIntegrityPreserved": { "type": "boolean", "const": true },
        "sourceHashIntegrityPreserved": { "type": "boolean", "const": true },
        "limitationsPreserved": { "type": "boolean", "const": true },
        "studentAudienceScopeReviewed": { "type": "boolean", "const": true },
        "finalAnswerPublished": { "type": "boolean", "const": false },
        "publicationCandidateCreated": { "type": "boolean", "const": false },
        "studentVisible": { "type": "boolean", "const": false },
        "studentDeliveryStarted": { "type": "boolean", "const": false },
        "directPublicationAllowed": { "type": "boolean", "const": false },
        "externalModelCallStarted": { "type": "boolean", "const": false },
        "mainDatabaseWriteStarted": { "type": "boolean", "const": false },
        "studentArchiveWriteStarted": { "type": "boolean", "const": false },
        "remoteDeviceControlAllowed": { "type": "boolean", "const": false },
        "localToolMutationAllowed": { "type": "boolean", "const": false },
        "swarmAllowed": { "type": "boolean", "const": false },
        "requiresFutureStudentDeliveryRuntime": { "type": "boolean", "const": true },
        "requiresFuturePersistenceReview": { "type": "boolean", "const": true }
      }
    },
    "runtimeSlo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetP99Ms", "evidenceClass"],
      "properties": {
        "targetP99Ms": { "type": "integer", "minimum": 1, "maximum": 300 },
        "evidenceClass": {
          "type": "string",
          "const": "ASYNC_DEEP_RESEARCH_STUDENT_VISIBILITY_REVIEW_BOUNDARY"
        }
      }
    },
    "nextAction": { "type": "string", "minLength": 1 }
  }
}
