{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/agent/skills/search-teaching-material.input.schema.json",
  "title": "Search Teaching Material Skill Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "invocationId",
    "taskId",
    "contextRef",
    "principalContextRef",
    "query",
    "filters",
    "limits",
    "evidenceRefs",
    "latencyBudgetMs",
    "writeIntent",
    "studentDataAccess",
    "externalModelAllowed"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-04.agent.skill.search-teaching-material.input.v1"
    },
    "invocationId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "contextRef": { "type": "string", "minLength": 1 },
    "principalContextRef": { "type": "string", "minLength": 1 },
    "query": { "type": "string", "minLength": 1, "maxLength": 500 },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerType", "materialTypes", "tags", "includeStudentArchive"],
      "properties": {
        "ownerType": { "type": "string", "const": "TEACHING" },
        "materialTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["TEACHING_MATERIAL", "HANDOUT", "QUIZ", "PAPER"]
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "includeStudentArchive": { "type": "boolean", "const": false }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxResults", "maxSnippetChars"],
      "properties": {
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxSnippetChars": { "type": "integer", "minimum": 0, "maximum": 500 }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "latencyBudgetMs": { "type": "integer", "minimum": 1, "maximum": 50 },
    "writeIntent": { "type": "boolean", "const": false },
    "studentDataAccess": { "type": "string", "const": "NONE" },
    "externalModelAllowed": { "type": "boolean", "const": false }
  }
}
