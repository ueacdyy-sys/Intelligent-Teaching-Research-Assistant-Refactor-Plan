{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/agent/skills/search-knowledge.input.schema.json",
  "title": "Search Knowledge Skill Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "invocationId",
    "taskId",
    "contextRef",
    "principalContextRef",
    "query",
    "filters",
    "limits",
    "evidenceRefs",
    "latencyBudgetMs",
    "writeIntent",
    "studentDataAccess",
    "externalModelAllowed",
    "synthesisAllowed"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-04.agent.skill.search-knowledge.input.v1"
    },
    "invocationId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "contextRef": { "type": "string", "minLength": 1 },
    "principalContextRef": { "type": "string", "minLength": 1 },
    "query": { "type": "string", "minLength": 1, "maxLength": 800 },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeType", "allowedClassifications", "intentTags", "includeStudentArchive"],
      "properties": {
        "nodeType": { "type": "string", "enum": ["CLOUD", "LOCAL", "REMOTE_DEVICE"] },
        "allowedClassifications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["PUBLIC", "PRIVATE", "REMOTE_DEVICE_OWNED"]
          }
        },
        "intentTags": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "includeStudentArchive": { "type": "boolean", "const": false }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxResults", "maxSnippetChars"],
      "properties": {
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxSnippetChars": { "type": "integer", "minimum": 0, "maximum": 600 }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "latencyBudgetMs": { "type": "integer", "minimum": 1, "maximum": 50 },
    "writeIntent": { "type": "boolean", "const": false },
    "studentDataAccess": { "type": "string", "const": "NONE" },
    "externalModelAllowed": { "type": "boolean", "const": false },
    "synthesisAllowed": { "type": "boolean", "const": false }
  }
}
