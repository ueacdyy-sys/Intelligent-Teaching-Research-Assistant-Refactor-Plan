{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/agent/skills/recommend-practice.output.schema.json",
  "title": "Recommend Practice Skill Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "invocationId",
    "taskId",
    "contextRef",
    "decision",
    "summary",
    "recommendations",
    "evidenceRefs",
    "safety",
    "slo"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-04.agent.skill.recommend-practice.output.v1"
    },
    "invocationId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "contextRef": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "enum": ["FOUND", "NO_MATCH", "NEEDS_MORE_CONTEXT", "DENIED"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "recommendations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "practiceId",
          "title",
          "sourceType",
          "knowledgePointIds",
          "reason",
          "sourceEvidenceRefs",
          "expiresAt"
        ],
        "properties": {
          "practiceId": { "type": "string", "pattern": "^practice_[a-zA-Z0-9_-]+$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sourceType": {
            "type": "string",
            "enum": ["TEACHING_MATERIAL", "QUESTION_BANK", "ARCHIVE_DERIVED_PRACTICE"]
          },
          "knowledgePointIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "sourceEvidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directDatabaseWriteAllowed",
        "crossStudentDataReturned",
        "rawStudentArchiveReturned",
        "finalEvaluationReturned",
        "externalModelUsed",
        "localToolMutationAllowed",
        "returnedWithinStudentScope"
      ],
      "properties": {
        "directDatabaseWriteAllowed": { "type": "boolean", "const": false },
        "crossStudentDataReturned": { "type": "boolean", "const": false },
        "rawStudentArchiveReturned": { "type": "boolean", "const": false },
        "finalEvaluationReturned": { "type": "boolean", "const": false },
        "externalModelUsed": { "type": "boolean", "const": false },
        "localToolMutationAllowed": { "type": "boolean", "const": false },
        "returnedWithinStudentScope": { "type": "boolean", "const": true }
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p99BudgetMs", "runtimeEvidenceClass", "runtimeEvidenceRequiredBeforePromotion"],
      "properties": {
        "p99BudgetMs": { "type": "integer", "minimum": 1, "maximum": 50 },
        "runtimeEvidenceClass": { "type": "string", "const": "CONTRACT_ONLY" },
        "runtimeEvidenceRequiredBeforePromotion": { "type": "boolean", "const": true }
      }
    }
  }
}
