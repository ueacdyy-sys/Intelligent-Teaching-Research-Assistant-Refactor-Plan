{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/agent/student-app-ai-tutor-result.input.schema.json",
  "title": "Student App AI Tutor Result Runtime Input",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "resultInvocationId",
    "principal",
    "worker",
    "claim",
    "result",
    "resultPolicy",
    "evidenceRefs",
    "idempotencyKey"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-05.student-app.ai-tutor-result.v1"
    },
    "resultInvocationId": { "type": "string", "minLength": 1 },
    "principal": {
      "type": "object",
      "required": ["subjectType", "role", "entryPoint", "scopes"],
      "properties": {
        "subjectType": { "const": "SERVICE" },
        "role": { "const": "SERVICE" },
        "entryPoint": { "const": "AGENT_INTERNAL" },
        "scopes": {
          "type": "array",
          "contains": { "const": "TEACHING_WRITE" }
        }
      }
    },
    "worker": {
      "type": "object",
      "required": ["workerId", "agent", "skillId", "nodeType"],
      "properties": {
        "workerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "agent": { "const": "StudentTutorAgent" },
        "skillId": { "const": "tutor_student" },
        "nodeType": { "const": "LOCAL" }
      }
    },
    "claim": {
      "type": "object",
      "required": ["requestId", "archiveItemId", "status", "claimedByWorkerId", "claimExpiresAt", "questionBankIntent"],
      "properties": {
        "requestId": { "type": "string", "pattern": "^tutor_req_" },
        "archiveItemId": { "type": "string", "pattern": "^tarch_" },
        "status": { "const": "IN_PROGRESS" },
        "claimedByWorkerId": { "type": "string", "minLength": 1 },
        "claimExpiresAt": { "type": "string", "minLength": 1 },
        "questionBankIntent": { "enum": ["NONE", "GENERATE_PERSONALIZED_CHECK"] }
      }
    },
    "result": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["SUCCEEDED", "FAILED"] },
        "resultSummary": { "type": "string", "maxLength": 2000 },
        "resultRef": { "type": "string", "maxLength": 1000 },
        "questionBankDraftRef": { "type": "string", "maxLength": 1000 },
        "errorCode": { "type": "string", "maxLength": 64 },
        "errorMessage": { "type": "string", "maxLength": 1000 }
      }
    },
    "resultPolicy": {
      "type": "object",
      "required": [
        "queueName",
        "queueTable",
        "targetUseCase",
        "readRepositoryOperation",
        "writeRepositoryOperation",
        "internalServiceOnly",
        "claimRequired",
        "workerLeaseMustMatch",
        "modelExecutionAlreadyCompletedElsewhere",
        "executeModelNowAllowed",
        "createQuestionBankDraftNowAllowed",
        "studentVisiblePublishAllowed",
        "directDatabaseAccessAllowed",
        "executeHttpRequestAllowed",
        "remoteDeviceControlAllowed",
        "localToolMutationAllowed",
        "swarmAllowed"
      ],
      "properties": {
        "queueName": { "const": "student_app_ai_tutor" },
        "queueTable": { "const": "teaching_tutoring_analysis_requests" },
        "targetUseCase": { "const": "RecordTutoringAnalysisResult.Execute" },
        "readRepositoryOperation": { "const": "ArchiveRepository.GetTutoringAnalysisRequestByID" },
        "writeRepositoryOperation": { "const": "ArchiveRepository.RecordTutoringAnalysisResult" },
        "internalServiceOnly": { "const": true },
        "claimRequired": { "const": true },
        "workerLeaseMustMatch": { "const": true },
        "modelExecutionAlreadyCompletedElsewhere": { "const": true },
        "executeModelNowAllowed": { "const": false },
        "createQuestionBankDraftNowAllowed": { "const": false },
        "studentVisiblePublishAllowed": { "const": false },
        "directDatabaseAccessAllowed": { "const": false },
        "executeHttpRequestAllowed": { "const": false },
        "remoteDeviceControlAllowed": { "const": false },
        "localToolMutationAllowed": { "const": false },
        "swarmAllowed": { "const": false }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "idempotencyKey": { "type": "string", "minLength": 8 }
  }
}
