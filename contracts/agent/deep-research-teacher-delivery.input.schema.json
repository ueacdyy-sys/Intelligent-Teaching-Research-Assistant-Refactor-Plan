{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/agent/deep-research-teacher-delivery.input.schema.json",
  "title": "Deep Research Teacher Delivery Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deliveryInvocationId",
    "principal",
    "publicationPrecheckRecord",
    "renderPreviewRecord",
    "deliveryPolicy",
    "teacherDeliveryPackage",
    "evidenceRefs",
    "idempotencyKey"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-05.research.deep-research-teacher-delivery.v1"
    },
    "deliveryInvocationId": { "type": "string", "minLength": 1 },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "role", "subjectType", "entryPoint", "scopes", "sessionId"],
      "properties": {
        "principalId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["TEACHER", "ADMIN"] },
        "subjectType": { "type": "string", "const": "USER" },
        "entryPoint": { "type": "string", "enum": ["DESKTOP_RESEARCH", "DESKTOP_TEACHER"] },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["RESEARCH_READ", "RESEARCH_WRITE", "KNOWLEDGE_PRIVATE_READ", "ADMIN_SYSTEM"]
          }
        },
        "sessionId": { "type": "string", "minLength": 1 }
      }
    },
    "publicationPrecheckRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "runtimeId", "commandPort", "status", "recordId", "job", "precheck", "evidenceRefs", "boundary"],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "2026-06-05.research.deep-research-publication-precheck-recorded.v1"
        },
        "runtimeId": { "type": "string", "const": "research_deep_research_publication_precheck_runtime" },
        "commandPort": {
          "type": "string",
          "const": "DeepResearchPublicationPrecheckPort.recordDeepResearchPublicationPrecheck"
        },
        "status": { "type": "string", "const": "PUBLICATION_PRECHECK_APPROVED_NOT_DELIVERED" },
        "recordId": { "type": "string", "minLength": 1 },
        "job": { "$ref": "#/$defs/researchJob" },
        "precheck": {
          "type": "object",
          "additionalProperties": true,
          "required": ["decision", "approvedForFutureDelivery", "revisionRequired", "previewId", "artifactId"],
          "properties": {
            "decision": { "type": "string", "const": "APPROVED_FOR_DELIVERY_RUNTIME" },
            "approvedForFutureDelivery": { "type": "boolean", "const": true },
            "revisionRequired": { "type": "boolean", "const": false },
            "previewId": { "type": "string", "minLength": 1 },
            "artifactId": { "type": "string", "minLength": 1 }
          }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "boundary": { "type": "object", "additionalProperties": true }
      }
    },
    "renderPreviewRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "runtimeId", "commandPort", "status", "recordId", "job", "preview", "evidenceRefs", "boundary"],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "2026-06-05.research.deep-research-render-preview-recorded.v1"
        },
        "runtimeId": { "type": "string", "const": "research_deep_research_render_preview_runtime" },
        "commandPort": {
          "type": "string",
          "const": "DeepResearchRenderPreviewPort.recordDeepResearchRenderPreview"
        },
        "status": { "type": "string", "const": "RENDER_PREVIEW_READY_NOT_PUBLISHED" },
        "recordId": { "type": "string", "minLength": 1 },
        "job": { "$ref": "#/$defs/researchJob" },
        "preview": { "type": "object", "additionalProperties": true },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "boundary": { "type": "object", "additionalProperties": true }
      }
    },
    "deliveryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationPrecheckRequired",
        "renderPreviewRequired",
        "teacherDeliveryAllowed",
        "preserveEvidenceRequired",
        "preserveSourceHashesRequired",
        "preserveLimitationsRequired",
        "futureStudentDeliveryReviewRequired",
        "studentVisibleDeliveryAllowed",
        "directPublicationAllowed",
        "directDatabaseAccessAllowed",
        "mainDatabaseWriteAllowed",
        "studentArchiveWriteAllowed",
        "externalModelCallAllowed",
        "remoteDeviceControlAllowed",
        "localToolMutationAllowed",
        "swarmAllowed"
      ],
      "properties": {
        "publicationPrecheckRequired": { "type": "boolean", "const": true },
        "renderPreviewRequired": { "type": "boolean", "const": true },
        "teacherDeliveryAllowed": { "type": "boolean", "const": true },
        "preserveEvidenceRequired": { "type": "boolean", "const": true },
        "preserveSourceHashesRequired": { "type": "boolean", "const": true },
        "preserveLimitationsRequired": { "type": "boolean", "const": true },
        "futureStudentDeliveryReviewRequired": { "type": "boolean", "const": true },
        "studentVisibleDeliveryAllowed": { "type": "boolean", "const": false },
        "directPublicationAllowed": { "type": "boolean", "const": false },
        "directDatabaseAccessAllowed": { "type": "boolean", "const": false },
        "mainDatabaseWriteAllowed": { "type": "boolean", "const": false },
        "studentArchiveWriteAllowed": { "type": "boolean", "const": false },
        "externalModelCallAllowed": { "type": "boolean", "const": false },
        "remoteDeviceControlAllowed": { "type": "boolean", "const": false },
        "localToolMutationAllowed": { "type": "boolean", "const": false },
        "swarmAllowed": { "type": "boolean", "const": false }
      }
    },
    "teacherDeliveryPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "packageKind", "audience", "channel", "format", "deliveryState", "title", "summary", "teacherNotes"],
      "properties": {
        "packageId": { "type": "string", "minLength": 1 },
        "packageKind": { "type": "string", "const": "EVIDENCE_GROUNDED_TEACHER_DELIVERY_PACKAGE" },
        "audience": { "type": "string", "const": "TEACHER_RESEARCH" },
        "channel": { "type": "string", "const": "DESKTOP_RESEARCH" },
        "format": { "type": "string", "const": "SAFE_TEXT_BLOCKS" },
        "deliveryState": { "type": "string", "const": "TEACHER_READY_NOT_STUDENT_VISIBLE" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "teacherNotes": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 220 }
  },
  "$defs": {
    "researchJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "contextRef", "jobId", "queueName"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "contextRef": { "type": "string", "minLength": 1 },
        "jobId": { "type": "string", "minLength": 1 },
        "queueName": { "type": "string", "const": "research_deep_research" }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
