{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/agent/research-agent-readonly-adapter.schema.json",
  "title": "ResearchAgent Read-Only Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adapterId",
    "workerAgent",
    "skillId",
    "routeMode",
    "readPort",
    "inputSchemaRef",
    "outputSchemaRef",
    "guards",
    "evidence",
    "slo",
    "promotion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-04.agent.research-readonly-adapter.v1"
    },
    "adapterId": { "type": "string", "const": "research_agent_search_knowledge_readonly_adapter" },
    "workerAgent": { "type": "string", "const": "ResearchAgent" },
    "skillId": { "type": "string", "const": "search_knowledge" },
    "routeMode": { "type": "string", "const": "SINGLE_WORKER" },
    "inputSchemaRef": {
      "type": "string",
      "const": "contracts/agent/skills/search-knowledge.input.schema.json"
    },
    "outputSchemaRef": {
      "type": "string",
      "const": "contracts/agent/skills/search-knowledge.output.schema.json"
    },
    "readPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portName",
        "operation",
        "transport",
        "directDatabaseAccessAllowed",
        "writeOperationAllowed"
      ],
      "properties": {
        "portName": { "type": "string", "const": "KnowledgeQueryReadPort" },
        "operation": { "type": "string", "const": "searchKnowledge" },
        "transport": { "type": "string", "enum": ["HTTP", "IN_PROCESS"] },
        "directDatabaseAccessAllowed": { "type": "boolean", "const": false },
        "writeOperationAllowed": { "type": "boolean", "const": false }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principalContextRequired",
        "sharedContextRequired",
        "guardrailResultRequired",
        "denyOnWriteIntent",
        "denyOnStudentArchiveRequest",
        "denyOnExternalModelRequest",
        "denyOnLocalToolMutation",
        "dataScopes"
      ],
      "properties": {
        "principalContextRequired": { "type": "boolean", "const": true },
        "sharedContextRequired": { "type": "boolean", "const": true },
        "guardrailResultRequired": { "type": "boolean", "const": true },
        "denyOnWriteIntent": { "type": "boolean", "const": true },
        "denyOnStudentArchiveRequest": { "type": "boolean", "const": true },
        "denyOnExternalModelRequest": { "type": "boolean", "const": true },
        "denyOnLocalToolMutation": { "type": "boolean", "const": true },
        "dataScopes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["knowledge", "student", "teaching", "research", "localTool"],
          "properties": {
            "knowledge": { "type": "string", "const": "PRIVATE_ASSIGNED" },
            "student": { "type": "string", "const": "NONE" },
            "teaching": { "type": "string", "const": "NONE" },
            "research": { "type": "string", "const": "READ" },
            "localTool": { "type": "string", "const": "NONE" }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillInvocationTraceRequired",
        "inputHashRequired",
        "outputSummaryRequired",
        "sourceEvidenceRefsRequired",
        "runtimeTimingRequired"
      ],
      "properties": {
        "skillInvocationTraceRequired": { "type": "boolean", "const": true },
        "inputHashRequired": { "type": "boolean", "const": true },
        "outputSummaryRequired": { "type": "boolean", "const": true },
        "sourceEvidenceRefsRequired": { "type": "boolean", "const": true },
        "runtimeTimingRequired": { "type": "boolean", "const": true }
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p99BudgetMs", "maxResults", "maxSnippetChars"],
      "properties": {
        "p99BudgetMs": { "type": "integer", "minimum": 1, "maximum": 50 },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxSnippetChars": { "type": "integer", "minimum": 0, "maximum": 600 }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentEvidenceClass",
        "runtimeEvidenceRequiredBeforePromotion",
        "rootWorkflowRequired"
      ],
      "properties": {
        "currentEvidenceClass": { "type": "string", "const": "CONTRACT_ONLY" },
        "runtimeEvidenceRequiredBeforePromotion": { "type": "boolean", "const": true },
        "rootWorkflowRequired": { "type": "boolean", "const": true }
      }
    }
  }
}
