{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelligent-teaching-assistant.local/contracts/agent/deep-research-student-archive-storage-commit.output.schema.json",
  "title": "Research deep_research student archive storage commit output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeId",
    "commandPort",
    "status",
    "recordId",
    "recordedAt",
    "idempotencyKey",
    "idempotentReplay",
    "sourcePrecommit",
    "teachingArchiveCommit",
    "evidenceRefs",
    "boundary",
    "runtimeSlo",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2026-06-05.research.deep-research-student-archive-storage-commit-committed.v1"
    },
    "runtimeId": {
      "const": "research_deep_research_student_archive_storage_commit_runtime"
    },
    "commandPort": {
      "const": "DeepResearchStudentArchiveStorageCommitPort.commitTeachingArchiveCreateCommand"
    },
    "status": {
      "const": "TEACHING_ARCHIVE_MAIN_DB_STORAGE_COMMITTED"
    },
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 240
    },
    "idempotentReplay": {
      "type": "boolean"
    },
    "sourcePrecommit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["precommitRecordId", "preparedCommandId", "sourceProjection"],
      "properties": {
        "precommitRecordId": { "type": "string", "minLength": 1 },
        "preparedCommandId": { "type": "string", "minLength": 1 },
        "sourceProjection": { "type": "object" }
      }
    },
    "teachingArchiveCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "targetUseCase",
        "targetRepository",
        "targetTable",
        "archiveItem",
        "persistence"
      ],
      "properties": {
        "operationId": { "const": "createTeachingArchiveItem" },
        "targetUseCase": { "const": "CreateArchiveItem.ExecuteWithPersistence" },
        "targetRepository": { "const": "ArchiveRepository.Create" },
        "targetTable": { "const": "teaching_archive_items" },
        "archiveItem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "ownerType",
            "studentId",
            "materialType",
            "title",
            "source",
            "contentRef",
            "tags",
            "analysisIntents",
            "ocrStatus",
            "createdAt"
          ],
          "properties": {
            "id": { "type": "string", "pattern": "^tarch_" },
            "ownerType": { "const": "STUDENT" },
            "studentId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "materialType": { "enum": ["QUIZ", "PAPER", "HANDOUT", "HOMEWORK"] },
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "source": { "const": "SYSTEM_IMPORT" },
            "contentRef": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "tags": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 64 },
              "uniqueItems": true
            },
            "analysisIntents": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "ocrStatus": { "enum": ["RESERVED", "NOT_REQUIRED"] },
            "createdAt": { "type": "string", "format": "date-time" }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "commandId"],
          "properties": {
            "status": { "const": "persisted" },
            "commandId": { "type": "string" }
          }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "studentArchiveStoragePrecommitVerified": { "const": true },
        "teachingArchiveUseCasePortInvoked": { "const": true },
        "teachingArchiveDomainValidationExecuted": { "const": true },
        "teachingArchiveRepositoryPersisted": { "const": true },
        "projectionEvidencePreserved": { "const": true },
        "studentAudienceScopeEnforced": { "const": true },
        "mainDatabaseWritePrepared": { "const": true },
        "mainDatabaseWriteStarted": { "const": true },
        "mainDatabaseWriteCommitted": { "const": true },
        "directDatabaseAccessAllowed": { "const": false },
        "executeHttpRequestAllowed": { "const": false },
        "externalModelCallStarted": { "const": false },
        "localToolMutationAllowed": { "const": false },
        "swarmAllowed": { "const": false }
      }
    },
    "runtimeSlo": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "targetP99Ms": { "const": 300 },
        "evidenceClass": { "const": "ASYNC_DEEP_RESEARCH_STUDENT_ARCHIVE_STORAGE_COMMIT_BOUNDARY" }
      }
    },
    "nextAction": {
      "type": "string",
      "minLength": 1
    }
  }
}
