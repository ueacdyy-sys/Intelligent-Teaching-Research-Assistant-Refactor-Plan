{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/agent/deep-research-finalization.input.schema.json",
  "title": "Deep Research Finalization Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "finalizationInvocationId",
    "principal",
    "finalAnswerReviewRecord",
    "finalizationPolicy",
    "artifact",
    "evidenceRefs",
    "idempotencyKey"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-05.research.deep-research-finalization.v1"
    },
    "finalizationInvocationId": { "type": "string", "minLength": 1 },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "role", "subjectType", "entryPoint", "scopes", "sessionId"],
      "properties": {
        "principalId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["TEACHER", "ADMIN"] },
        "subjectType": { "type": "string", "const": "USER" },
        "entryPoint": { "type": "string", "enum": ["DESKTOP_RESEARCH", "DESKTOP_TEACHER"] },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["RESEARCH_READ", "RESEARCH_WRITE", "KNOWLEDGE_PRIVATE_READ", "ADMIN_SYSTEM"]
          }
        },
        "sessionId": { "type": "string", "minLength": 1 }
      }
    },
    "finalAnswerReviewRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "runtimeId", "commandPort", "status", "recordId", "job", "synthesis", "review", "evidenceRefs", "boundary"],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "2026-06-05.research.deep-research-final-answer-review-recorded.v1"
        },
        "runtimeId": { "type": "string", "const": "research_deep_research_final_answer_review_runtime" },
        "commandPort": {
          "type": "string",
          "const": "DeepResearchFinalAnswerReviewPort.recordDeepResearchFinalAnswerReview"
        },
        "status": { "type": "string", "const": "FINAL_ANSWER_REVIEW_APPROVED_FOR_FINALIZATION" },
        "recordId": { "type": "string", "minLength": 1 },
        "job": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taskId", "contextRef", "jobId", "queueName"],
          "properties": {
            "taskId": { "type": "string", "minLength": 1 },
            "contextRef": { "type": "string", "minLength": 1 },
            "jobId": { "type": "string", "minLength": 1 },
            "queueName": { "type": "string", "const": "research_deep_research" }
          }
        },
        "synthesis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recordId", "draftId", "claimCount", "citationCount", "sourceHashCount"],
          "properties": {
            "recordId": { "type": "string", "minLength": 1 },
            "draftId": { "type": "string", "minLength": 1 },
            "claimCount": { "type": "integer", "minimum": 1 },
            "citationCount": { "type": "integer", "minimum": 1 },
            "sourceHashCount": { "type": "integer", "minimum": 1 }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": true,
          "required": ["reviewId", "reviewerPrincipalId", "decision", "approvedForFinalization", "revisionRequired", "coverage", "risk"],
          "properties": {
            "reviewId": { "type": "string", "minLength": 1 },
            "reviewerPrincipalId": { "type": "string", "minLength": 1 },
            "decision": { "type": "string", "const": "APPROVED_FOR_FINALIZATION" },
            "approvedForFinalization": { "type": "boolean", "const": true },
            "revisionRequired": { "type": "boolean", "const": false },
            "coverage": { "type": "object" },
            "risk": { "type": "object" }
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "humanFinalAnswerReviewRecorded",
            "approvedForFutureFinalization",
            "revisionRequired",
            "finalAnswerGenerated",
            "finalAnswerPublished",
            "directPublicationAllowed",
            "externalModelCallStarted",
            "mainDatabaseWriteStarted",
            "studentArchiveWriteStarted",
            "localToolMutationAllowed",
            "swarmAllowed",
            "requiresFutureFinalizationRuntime"
          ],
          "properties": {
            "humanFinalAnswerReviewRecorded": { "type": "boolean", "const": true },
            "approvedForFutureFinalization": { "type": "boolean", "const": true },
            "revisionRequired": { "type": "boolean", "const": false },
            "finalAnswerGenerated": { "type": "boolean", "const": false },
            "finalAnswerPublished": { "type": "boolean", "const": false },
            "directPublicationAllowed": { "type": "boolean", "const": false },
            "externalModelCallStarted": { "type": "boolean", "const": false },
            "mainDatabaseWriteStarted": { "type": "boolean", "const": false },
            "studentArchiveWriteStarted": { "type": "boolean", "const": false },
            "localToolMutationAllowed": { "type": "boolean", "const": false },
            "swarmAllowed": { "type": "boolean", "const": false },
            "requiresFutureFinalizationRuntime": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "finalizationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedReviewRequired",
        "preserveEvidenceRefsRequired",
        "preserveCitationCountsRequired",
        "preserveSourceHashCountsRequired",
        "answerBodyAllowed",
        "publicationAllowed",
        "directPublicationAllowed",
        "directDatabaseAccessAllowed",
        "mainDatabaseWriteAllowed",
        "studentArchiveWriteAllowed",
        "remoteDeviceControlAllowed",
        "externalModelCallAllowed",
        "localToolMutationAllowed",
        "swarmAllowed",
        "requiresFuturePublicationReview"
      ],
      "properties": {
        "approvedReviewRequired": { "type": "boolean", "const": true },
        "preserveEvidenceRefsRequired": { "type": "boolean", "const": true },
        "preserveCitationCountsRequired": { "type": "boolean", "const": true },
        "preserveSourceHashCountsRequired": { "type": "boolean", "const": true },
        "answerBodyAllowed": { "type": "boolean", "const": false },
        "publicationAllowed": { "type": "boolean", "const": false },
        "directPublicationAllowed": { "type": "boolean", "const": false },
        "directDatabaseAccessAllowed": { "type": "boolean", "const": false },
        "mainDatabaseWriteAllowed": { "type": "boolean", "const": false },
        "studentArchiveWriteAllowed": { "type": "boolean", "const": false },
        "remoteDeviceControlAllowed": { "type": "boolean", "const": false },
        "externalModelCallAllowed": { "type": "boolean", "const": false },
        "localToolMutationAllowed": { "type": "boolean", "const": false },
        "swarmAllowed": { "type": "boolean", "const": false },
        "requiresFuturePublicationReview": { "type": "boolean", "const": true }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactKind", "finalizationLabel", "deliveryState"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "artifactKind": { "type": "string", "const": "REVIEWED_DEEP_RESEARCH_FINALIZATION_RECORD" },
        "finalizationLabel": { "type": "string", "minLength": 1, "maxLength": 160 },
        "deliveryState": { "type": "string", "const": "FINALIZED_NOT_PUBLISHED" }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 220 }
  }
}
