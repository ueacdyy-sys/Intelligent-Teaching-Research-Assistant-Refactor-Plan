{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/agent/deep-research-render-preview.input.schema.json",
  "title": "Deep Research Render Preview Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "previewInvocationId",
    "principal",
    "reasoningSynthesisRecord",
    "finalizationRecord",
    "renderPolicy",
    "presentation",
    "evidenceRefs",
    "idempotencyKey"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-05.research.deep-research-render-preview.v1"
    },
    "previewInvocationId": { "type": "string", "minLength": 1 },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "role", "subjectType", "entryPoint", "scopes", "sessionId"],
      "properties": {
        "principalId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["TEACHER", "ADMIN"] },
        "subjectType": { "type": "string", "const": "USER" },
        "entryPoint": { "type": "string", "enum": ["DESKTOP_RESEARCH", "DESKTOP_TEACHER"] },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["RESEARCH_READ", "RESEARCH_WRITE", "KNOWLEDGE_PRIVATE_READ", "ADMIN_SYSTEM"]
          }
        },
        "sessionId": { "type": "string", "minLength": 1 }
      }
    },
    "reasoningSynthesisRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "runtimeId", "status", "recordId", "job", "draft", "usage", "evidenceRefs", "boundary"],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "2026-06-05.research.deep-research-reasoning-synthesis-recorded.v1"
        },
        "runtimeId": { "type": "string", "const": "research_deep_research_reasoning_synthesis_runtime" },
        "status": { "type": "string", "const": "REASONING_SYNTHESIS_DRAFT_RECORDED" },
        "recordId": { "type": "string", "minLength": 1 },
        "job": { "$ref": "#/$defs/researchJob" },
        "draft": {
          "type": "object",
          "additionalProperties": true,
          "required": ["draftId", "answerKind", "title", "summary", "claims", "limitations"],
          "properties": {
            "draftId": { "type": "string", "minLength": 1 },
            "answerKind": { "type": "string", "const": "EVIDENCE_GROUNDED_DRAFT" },
            "title": { "type": "string", "minLength": 1, "maxLength": 240 },
            "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
            "claims": { "type": "array", "minItems": 1 },
            "limitations": { "type": "array", "minItems": 1 }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["draftTokens", "claimCount", "citationCount", "sourceHashCount"],
          "properties": {
            "draftTokens": { "type": "integer", "minimum": 1 },
            "claimCount": { "type": "integer", "minimum": 1 },
            "citationCount": { "type": "integer", "minimum": 1 },
            "sourceHashCount": { "type": "integer", "minimum": 1 }
          }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "boundary": { "type": "object", "additionalProperties": true }
      }
    },
    "finalizationRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "runtimeId", "commandPort", "status", "recordId", "job", "artifact", "evidenceRefs", "boundary"],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "2026-06-05.research.deep-research-finalization-recorded.v1"
        },
        "runtimeId": { "type": "string", "const": "research_deep_research_finalization_runtime" },
        "commandPort": {
          "type": "string",
          "const": "DeepResearchFinalizationPort.recordDeepResearchFinalization"
        },
        "status": { "type": "string", "const": "FINAL_ANSWER_FINALIZED_NOT_PUBLISHED" },
        "recordId": { "type": "string", "minLength": 1 },
        "job": { "$ref": "#/$defs/researchJob" },
        "artifact": {
          "type": "object",
          "additionalProperties": true,
          "required": ["artifactId", "artifactKind", "deliveryState", "reviewRecordId", "claimCount", "citationCount", "sourceHashCount"],
          "properties": {
            "artifactId": { "type": "string", "minLength": 1 },
            "artifactKind": { "type": "string", "const": "REVIEWED_DEEP_RESEARCH_FINALIZATION_RECORD" },
            "deliveryState": { "type": "string", "const": "FINALIZED_NOT_PUBLISHED" },
            "reviewRecordId": { "type": "string", "minLength": 1 },
            "claimCount": { "type": "integer", "minimum": 1 },
            "citationCount": { "type": "integer", "minimum": 1 },
            "sourceHashCount": { "type": "integer", "minimum": 1 }
          }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "boundary": { "type": "object", "additionalProperties": true }
      }
    },
    "renderPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finalizedArtifactRequired",
        "approvedReviewRequired",
        "preserveClaimsRequired",
        "preserveCitationsRequired",
        "preserveSourceHashesRequired",
        "encodeUnsafeTextRequired",
        "limitationsRequired",
        "publicationAllowed",
        "studentVisibleAllowed",
        "directDatabaseAccessAllowed",
        "mainDatabaseWriteAllowed",
        "studentArchiveWriteAllowed",
        "externalModelCallAllowed",
        "remoteDeviceControlAllowed",
        "localToolMutationAllowed",
        "swarmAllowed",
        "requiresFuturePublicationReview"
      ],
      "properties": {
        "finalizedArtifactRequired": { "type": "boolean", "const": true },
        "approvedReviewRequired": { "type": "boolean", "const": true },
        "preserveClaimsRequired": { "type": "boolean", "const": true },
        "preserveCitationsRequired": { "type": "boolean", "const": true },
        "preserveSourceHashesRequired": { "type": "boolean", "const": true },
        "encodeUnsafeTextRequired": { "type": "boolean", "const": true },
        "limitationsRequired": { "type": "boolean", "const": true },
        "publicationAllowed": { "type": "boolean", "const": false },
        "studentVisibleAllowed": { "type": "boolean", "const": false },
        "directDatabaseAccessAllowed": { "type": "boolean", "const": false },
        "mainDatabaseWriteAllowed": { "type": "boolean", "const": false },
        "studentArchiveWriteAllowed": { "type": "boolean", "const": false },
        "externalModelCallAllowed": { "type": "boolean", "const": false },
        "remoteDeviceControlAllowed": { "type": "boolean", "const": false },
        "localToolMutationAllowed": { "type": "boolean", "const": false },
        "swarmAllowed": { "type": "boolean", "const": false },
        "requiresFuturePublicationReview": { "type": "boolean", "const": true }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previewId", "previewKind", "audience", "format", "deliveryState"],
      "properties": {
        "previewId": { "type": "string", "minLength": 1 },
        "previewKind": { "type": "string", "const": "EVIDENCE_GROUNDED_RESEARCH_PREVIEW" },
        "audience": { "type": "string", "const": "TEACHER_REVIEW" },
        "format": { "type": "string", "const": "SAFE_TEXT_BLOCKS" },
        "deliveryState": { "type": "string", "const": "PREVIEW_READY_NOT_PUBLISHED" }
      }
    },
    "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 220 }
  },
  "$defs": {
    "researchJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "contextRef", "jobId", "queueName"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "contextRef": { "type": "string", "minLength": 1 },
        "jobId": { "type": "string", "minLength": 1 },
        "queueName": { "type": "string", "const": "research_deep_research" }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
