{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/ai-worker/ai-worker-runtime-dependency-profile.schema.json",
  "title": "AI Worker Runtime Dependency Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineManifests",
    "forbiddenBaselinePackages",
    "optionalWorkerBundles",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-05-30.ai-worker.runtime-dependency-profile.v1"
    },
    "baselineManifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "runtime"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "runtime": {
            "type": "string",
            "enum": ["NODE_BASELINE", "GO_BASELINE", "RUST_BASELINE"]
          }
        }
      }
    },
    "forbiddenBaselinePackages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "optionalWorkerBundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundleId",
          "capabilityKind",
          "executionOwner",
          "installMode",
          "baselineRuntimeDependencyAllowed",
          "packages"
        ],
        "properties": {
          "bundleId": {
            "type": "string",
            "minLength": 1
          },
          "capabilityKind": {
            "type": "string",
            "enum": ["RAG_RETRIEVAL", "OCR_RECOGNITION", "FINE_TUNING"]
          },
          "executionOwner": {
            "type": "string",
            "const": "PYTHON_WORKER"
          },
          "installMode": {
            "type": "string",
            "const": "OPTIONAL_WORKER_ENV"
          },
          "baselineRuntimeDependencyAllowed": {
            "type": "boolean",
            "const": false
          },
          "packages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["packageName", "purpose"],
              "properties": {
                "packageName": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
