{
  "sourceFiles": {
    "composeFile": "../智能教研助手/docker-compose.perf.yml",
    "composeOverrideFile": "infra/perf/docker-compose.pgbouncer.override.yml",
    "pgbouncerIni": "../智能教研助手/pgbouncer/perf.ini",
    "pgbouncerUserlist": "../智能教研助手/pgbouncer/perf-userlist.txt"
  },
  "expected": {
    "postgres": {
      "serviceName": "postgres-perf",
      "minMaxConnections": 300,
      "minSharedBuffers": "1GB"
    },
    "pgbouncer": {
      "serviceName": "pgbouncer-perf",
      "requiredPoolMode": "transaction",
      "maxDbConnectionsCeiling": 190,
      "requiredListenPort": 6432
    },
    "backend": {
      "serviceName": "backend-perf",
      "requiredPostgresHost": "pgbouncer-perf",
      "requiredPostgresPort": 6432,
      "maxDbPoolSize": 2,
      "requiredDbMaxOverflow": 0,
      "requiredWorkers": 24
    },
    "secrets": {
      "requiredValue": "ueacd",
      "keys": [
        "POSTGRES_PASSWORD",
        "AGENT_API_KEY",
        "ADMIN_API_KEY",
        "TRIGGER_API_KEY",
        "JWT_SECRET_KEY",
        "MASTER_ENCRYPTION_KEY",
        "COMMAND_SIGNATURE_SECRET",
        "BOOTSTRAP_SUPER_ADMIN_PASSWORD",
        "SERPAPI_API_KEY",
        "pgbouncer.app_user"
      ]
    }
  }
}
