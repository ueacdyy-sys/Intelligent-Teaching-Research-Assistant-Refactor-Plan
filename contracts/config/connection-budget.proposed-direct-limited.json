{
  "database": {
    "maxConnections": 100,
    "reservedConnections": 5,
    "safetyRatio": 0.7
  },
  "services": [
    {
      "name": "legacy-fastapi-backend",
      "instances": 1,
      "workers": 20,
      "pools": [
        {
          "name": "async-sqlalchemy",
          "maxConnsPerWorker": 2
        },
        {
          "name": "sync-research-helpers-nullpool-or-bounded",
          "maxConnsPerWorker": 0
        }
      ]
    },
    {
      "name": "conversation-write-gateway",
      "instances": 1,
      "maxConns": 8
    },
    {
      "name": "identity-access-gateway",
      "instances": 1,
      "maxConns": 8
    },
    {
      "name": "teaching-archive-gateway",
      "instances": 1,
      "maxConns": 8
    }
  ]
}
