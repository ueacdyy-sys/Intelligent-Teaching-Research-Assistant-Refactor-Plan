{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/harness/approval-decision-correlation.schema.json",
  "title": "Agent Harness Approval Decision Correlation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "totalApprovalArtifacts",
    "totalDecisions",
    "allCorrelated",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-05-29.agent-harness.approval-decision-correlation.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "totalApprovalArtifacts": {
      "type": "integer",
      "minimum": 0
    },
    "totalDecisions": {
      "type": "integer",
      "minimum": 0
    },
    "allCorrelated": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decisionId", "approvalId", "status", "issues"],
        "properties": {
          "decisionId": {
            "type": "string",
            "minLength": 1
          },
          "approvalId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "MATCHED",
              "MISSING_APPROVAL",
              "DUPLICATE_APPROVAL_ID",
              "CONTEXT_MISMATCH",
              "EXECUTION_READY_DECISION"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
