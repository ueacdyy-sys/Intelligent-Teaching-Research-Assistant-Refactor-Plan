{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/harness/approval-artifact.schema.json",
  "title": "Agent Harness Approval Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalId",
    "evidenceId",
    "requestedAt",
    "principalId",
    "sessionId",
    "action",
    "target",
    "reason",
    "status",
    "manifestSchemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-05-29.agent-harness.approval-artifact.v1"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "principalId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": ["FILE_READ", "FILE_WRITE", "PROCESS_START", "BROWSER_NAVIGATE"]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["PENDING"]
    },
    "manifestSchemaVersion": {
      "type": "string",
      "minLength": 1
    }
  }
}
