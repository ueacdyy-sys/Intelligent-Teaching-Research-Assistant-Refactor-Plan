{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/harness/approval-decision.schema.json",
  "title": "Agent Harness Approval Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "approvalId",
    "decidedAt",
    "reviewerPrincipalId",
    "reviewerSessionId",
    "requestedPrincipalId",
    "action",
    "target",
    "outcome",
    "reason",
    "sourceStatus",
    "executionReady"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-05-29.agent-harness.approval-decision.v1"
    },
    "decisionId": {
      "type": "string",
      "minLength": 1
    },
    "approvalId": {
      "type": "string",
      "minLength": 1
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewerPrincipalId": {
      "type": "string",
      "minLength": 1
    },
    "reviewerSessionId": {
      "type": "string",
      "minLength": 1
    },
    "requestedPrincipalId": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": ["FILE_READ", "FILE_WRITE", "PROCESS_START", "BROWSER_NAVIGATE"]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "sourceStatus": {
      "type": "string",
      "const": "PENDING"
    },
    "executionReady": {
      "type": "boolean",
      "const": false
    }
  }
}
