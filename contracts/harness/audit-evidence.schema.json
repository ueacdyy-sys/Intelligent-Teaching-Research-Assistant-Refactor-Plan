{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/harness/audit-evidence.schema.json",
  "title": "Agent Harness Audit Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "recordedAt",
    "principalId",
    "sessionId",
    "action",
    "target",
    "outcome",
    "reason",
    "dryRun",
    "manifestSchemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-05-29.agent-harness.audit-evidence.v1"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "principalId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": ["FILE_READ", "FILE_WRITE", "PROCESS_START", "BROWSER_NAVIGATE"]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "enum": ["ALLOW_DRY_RUN", "APPROVAL_REQUIRED", "DENY"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "dryRun": {
      "type": "boolean"
    },
    "manifestSchemaVersion": {
      "type": "string",
      "minLength": 1
    }
  }
}
