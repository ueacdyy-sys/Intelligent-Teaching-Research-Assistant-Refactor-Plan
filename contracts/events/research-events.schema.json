{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/events/research-events.schema.json",
  "title": "Research Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "occurredAt", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "type": "string",
      "enum": ["ConversationCreated"]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
