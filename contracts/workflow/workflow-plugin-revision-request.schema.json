{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/workflow/workflow-plugin-revision-request.schema.json",
  "title": "Workflow Plugin Revision Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "draftId",
    "sourceKind",
    "sourceEvidenceId",
    "revisionDecision",
    "saveBlocked",
    "issues",
    "recommendedActions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-05-30.workflow-plugin.revision-request.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "draftId": {
      "type": "string",
      "minLength": 1
    },
    "sourceKind": {
      "type": "string",
      "enum": ["SANDBOX_FAILURE", "HUMAN_REVISION_REQUEST"]
    },
    "sourceEvidenceId": {
      "type": "string",
      "minLength": 1
    },
    "revisionDecision": {
      "type": "string",
      "const": "REVISION_REQUIRED"
    },
    "saveBlocked": {
      "type": "boolean",
      "const": true
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommendedActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
