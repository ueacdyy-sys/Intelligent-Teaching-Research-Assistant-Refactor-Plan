{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/workflow/workflow-plugin-registry-admission.schema.json",
  "title": "Workflow Plugin Registry Admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "decision",
    "issues",
    "registryEntry"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-05-30.workflow-plugin.registry-admission.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "type": "string",
      "enum": ["ALLOW_SAVE", "BLOCK_SAVE"]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "registryEntry": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "workflow-plugin-registry-entry.schema.json" }
      ]
    }
  }
}
