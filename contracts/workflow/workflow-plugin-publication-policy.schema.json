{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/workflow/workflow-plugin-publication-policy.schema.json",
  "title": "Workflow Plugin Publication Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "registryEntryId",
    "executionIsolationRecordRef",
    "mode",
    "publicationAllowed",
    "publicationChannel",
    "registryExposure",
    "requiresExecutionIsolation",
    "requiresFutureSdd",
    "auditLogRequired"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-05.workflow-plugin.publication-policy.v1"
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "registryEntryId": {
      "type": "string",
      "minLength": 1
    },
    "executionIsolationRecordRef": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "const": "BLOCK_PUBLICATION"
    },
    "publicationAllowed": {
      "type": "boolean",
      "const": false
    },
    "publicationChannel": {
      "type": "string",
      "const": "DISABLED"
    },
    "registryExposure": {
      "type": "string",
      "const": "INTERNAL_DRY_RUN_CATALOG_ONLY"
    },
    "requiresExecutionIsolation": {
      "type": "boolean",
      "const": true
    },
    "requiresFutureSdd": {
      "type": "boolean",
      "const": true
    },
    "auditLogRequired": {
      "type": "boolean",
      "const": true
    }
  }
}
