{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/workflow/workflow-plugin-execution-isolation-policy.schema.json",
  "title": "Workflow Plugin Execution Isolation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "registryEntryId",
    "mode",
    "hostWritePolicy",
    "networkPolicy",
    "processLaunchAllowed",
    "candidateExposure",
    "requiresFutureSdd",
    "maxRuntimeMs",
    "maxMemoryMb",
    "auditLogRequired"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-06-05.workflow-plugin.execution-isolation-policy.v1"
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "registryEntryId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "const": "BLOCK_HOST_EXECUTION"
    },
    "hostWritePolicy": {
      "type": "string",
      "const": "DENY"
    },
    "networkPolicy": {
      "type": "string",
      "const": "DEFAULT_DENY"
    },
    "processLaunchAllowed": {
      "type": "boolean",
      "const": false
    },
    "candidateExposure": {
      "type": "string",
      "const": "DISABLED"
    },
    "requiresFutureSdd": {
      "type": "boolean",
      "const": true
    },
    "maxRuntimeMs": {
      "type": "integer",
      "minimum": 1
    },
    "maxMemoryMb": {
      "type": "integer",
      "minimum": 1
    },
    "auditLogRequired": {
      "type": "boolean",
      "const": true
    }
  }
}
