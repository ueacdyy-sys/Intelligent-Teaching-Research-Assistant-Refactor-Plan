{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ita.local/contracts/workflow/workflow-plugin-approval.schema.json",
  "title": "Workflow Plugin Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalId",
    "draftId",
    "sandboxRunId",
    "reviewerPrincipalId",
    "decision",
    "performanceReviewed",
    "effectReviewed",
    "registrySaveDecision",
    "reviewedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-05-30.workflow-plugin.approval.v1"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1
    },
    "draftId": {
      "type": "string",
      "minLength": 1
    },
    "sandboxRunId": {
      "type": "string",
      "minLength": 1
    },
    "reviewerPrincipalId": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED", "REVISION_REQUESTED"]
    },
    "performanceReviewed": {
      "type": "boolean",
      "const": true
    },
    "effectReviewed": {
      "type": "boolean",
      "const": true
    },
    "registrySaveDecision": {
      "type": "string",
      "enum": ["ALLOW_SAVE", "BLOCK_SAVE"]
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "comments": {
      "type": "string"
    }
  }
}
